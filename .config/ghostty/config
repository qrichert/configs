# Use `cmd/ctrl+shift+,` to reload the configuration.

# We can't change `background` based on light/dark mode, that's why
# we keep a customization of the default dark theme (only use case).
# background = #060607
background-opacity = 0.95
background-blur = 7

font-size = 16
font-feature = -calt
window-width = 80
window-height = 24

theme = light:Builtin Tango Light,dark:Ghostty Default Style Dark Custom
window-theme = system
macos-titlebar-style = tabs

keybind = global:cmd+m=toggle_quick_terminal
keybind = global:ctrl+m=toggle_quick_terminal

keybind = ctrl+shift+arrow_up=goto_split:previous
keybind = ctrl+shift+arrow_down=goto_split:next

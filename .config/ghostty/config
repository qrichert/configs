# Use `cmd/ctrl+shift+,` to reload the configuration.

background = #060607
background-opacity = 0.9
background-blur = 7

font-size = 16
font-feature = -calt
window-width = 80
window-height = 24

window-theme = dark
macos-titlebar-style = tabs

keybind = global:cmd+m=toggle_quick_terminal
keybind = global:ctrl+m=toggle_quick_terminal

keybind = ctrl+shift+arrow_up=goto_split:previous
keybind = ctrl+shift+arrow_down=goto_split:next
